# 复制为 .env 并填值;.env 已在 .gitignore,不会入库。
# 注:按 CLAUDE.md 锁定技术栈,LLM 用 DeepSeek/Qwen、Embedding 用本地 BGE,
#     故不含 OPENAI_API_KEY(不在范围内,避免暗示用到 OpenAI)。

# --- LLM(主:DeepSeek-V3) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- LLM(备:Qwen-Max,provider 切换备用,DashScope) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 可观测:LangSmith(阶段 5 接入) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=merchant-copilot
